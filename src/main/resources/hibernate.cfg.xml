<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <!-- Database Connection Settings -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <!-- Això ho heu de canviar per les vostres dades -->
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/videojocs?createDatabaseIfNotExist=true</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">super3</property>

        <!-- Necessari per fer servir sessionFactory.getCurrentSession() -->
        <property name="hibernate.current_session_context_class">thread</property>

        <!-- Aquesta és important. Valors: none | validate | update | create | create-drop
             Mentre fem proves, "create" esborra i torna a crear les taules a cada execució:
             així el programa es pot executar tantes vegades com vulguem sense errors de clau duplicada.
             Quan el model sigui estable (i a la pràctica), "update". -->
        <property name="hibernate.hbm2ddl.auto">create</property>

        <!-- Això ens permet xafardejar l'SQL que genera Hibernate. Opcional -->
        <property name="hibernate.show_sql">false</property>
        <!-- Això formata les sentències SQL -->
        <property name="hibernate.format_sql">false</property>
        <!-- Això mostra les sentències SQL en un altre color a la consola -->
        <property name="hibernate.highlight_sql">false</property>
        <!-- Això afegeix comentaris a les sentències
        <property name="hibernate.use_sql_comments">true</property>
        -->


        <!-- AQUÍ POSEU LES CLASSES QUE REPRESENTEN TAULES QUE FEU SERVIR -->
        <!-- Els enums (Pegi, Genere) NO van aquí: no són entitats -->
        <mapping class="models.Aresta"/>
        <mapping class="models.CartaDesenvolupament"/>
        <mapping class="models.Hexagon"/>
        <mapping class="models.HexagonVertex"/>
        <mapping class="models.Jugador"/>
        <mapping class="models.Partida"/>
        <mapping class="models.RecursJugador"/>
        <mapping class="models.Vertex"/>

        <mapping class="models.abstracts.Assentament"/>
        <mapping class="models.abstracts.Carretera"/>
        <mapping class="models.abstracts.Ciutat"/>
        <mapping class="models.abstracts.Construccio"/>
        <mapping class="models.abstracts.Poblat"/>


    </session-factory>
</hibernate-configuration>

